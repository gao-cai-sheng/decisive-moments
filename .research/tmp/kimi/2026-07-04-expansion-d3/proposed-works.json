{
  "schemaVersion": 1,
  "items": [
    { "id": "marcuse-eros-civilization", "philosopherId": "marcuse", "titleZh": "《爱欲与文明》", "titleEn": "Eros and Civilization", "yearDisplay": "1955", "noteZh": "把弗洛伊德欲望理论同马克思主义解放问题结合，讨论非压抑性文明可能性。" },
    { "id": "marcuse-one-dimensional-man", "philosopherId": "marcuse", "titleZh": "《单向度的人》", "titleEn": "One-Dimensional Man", "yearDisplay": "1964", "noteZh": "分析发达工业社会如何通过技术理性、消费和文化整合压缩批判与否定性。" },
    { "id": "marcuse-reason-revolution", "philosopherId": "marcuse", "titleZh": "《理性与革命》", "titleEn": "Reason and Revolution", "yearDisplay": "1941", "noteZh": "从黑格尔到社会理论解释否定理性与批判传统，为其马克思主义黑格尔解释奠基。" },
    { "id": "marcuse-essay-liberation", "philosopherId": "marcuse", "titleZh": "《论解放》", "titleEn": "An Essay on Liberation", "yearDisplay": "1969", "noteZh": "讨论新感性、反抗主体和解放想象，回应六十年代新左翼政治语境。" },
    { "id": "marcuse-repressive-tolerance", "philosopherId": "marcuse", "titleZh": "《压抑性宽容》", "titleEn": "Repressive Tolerance", "yearDisplay": "1965", "noteZh": "批判形式中立宽容在不平等社会中可能维护支配结构和既有舆论权力。" },

    { "id": "fromm-escape-freedom", "philosopherId": "fromm", "titleZh": "《逃避自由》", "titleEn": "Escape from Freedom", "yearDisplay": "1941", "noteZh": "分析现代个人在获得自由后因孤立和焦虑转向威权、破坏和自动顺从。" },
    { "id": "fromm-man-for-himself", "philosopherId": "fromm", "titleZh": "《自为的人》", "titleEn": "Man for Himself", "yearDisplay": "1947", "noteZh": "提出人本伦理学，把生产性人格和人的潜能实现作为伦理评价中心。" },
    { "id": "fromm-sane-society", "philosopherId": "fromm", "titleZh": "《健全的社会》", "titleEn": "The Sane Society", "yearDisplay": "1955", "noteZh": "批判资本主义社会的异化和病理，提出以人的需要为中心的社会重组。" },
    { "id": "fromm-marx-concept-man", "philosopherId": "fromm", "titleZh": "《马克思关于人的概念》", "titleEn": "Marx's Concept of Man", "yearDisplay": "1961", "noteZh": "阐释青年马克思的人本主义、异化和自由劳动思想，反对机械化马克思主义。" },
    { "id": "fromm-to-have-or-to-be", "philosopherId": "fromm", "titleZh": "《占有还是存在》", "titleEn": "To Have or To Be?", "yearDisplay": "1976", "noteZh": "区分占有式和存在式生活，批判消费社会并提出存在方式的伦理转向。" },

    { "id": "berlin-two-concepts-liberty", "philosopherId": "berlin", "titleZh": "《两种自由概念》", "titleEn": "Two Concepts of Liberty", "yearDisplay": "1958", "noteZh": "区分消极自由与积极自由，警惕积极自由被整体主义和强制政治挪用。" },
    { "id": "berlin-historical-inevitability", "philosopherId": "berlin", "titleZh": "《历史必然性》", "titleEn": "Historical Inevitability", "yearDisplay": "1954", "noteZh": "批判历史决定论和责任消解，维护选择、偶然性和道德责任。" },
    { "id": "berlin-hedgehog-fox", "philosopherId": "berlin", "titleZh": "《刺猬与狐狸》", "titleEn": "The Hedgehog and the Fox", "yearDisplay": "1953", "noteZh": "以托尔斯泰为例讨论单一大观念与多元现实理解之间的思想史张力。" },
    { "id": "berlin-four-essays-liberty", "philosopherId": "berlin", "titleZh": "《自由四论》", "titleEn": "Four Essays on Liberty", "yearDisplay": "1969", "noteZh": "汇集自由、政治判断和历史责任相关论文，集中呈现伯林自由主义立场。" },
    { "id": "berlin-roots-romanticism", "philosopherId": "berlin", "titleZh": "《浪漫主义的根源》", "titleEn": "The Roots of Romanticism", "yearDisplay": "1999 posthumous", "noteZh": "以讲演形式解释浪漫主义对价值多元、自我创造和现代思想的影响。" },

    { "id": "hayek-road-serfdom", "philosopherId": "hayek", "titleZh": "《通往奴役之路》", "titleEn": "The Road to Serfdom", "yearDisplay": "1944", "noteZh": "批判集中经济计划可能侵蚀法治、个人自由和民主政治的制度条件。" },
    { "id": "hayek-use-knowledge", "philosopherId": "hayek", "titleZh": "《知识在社会中的运用》", "titleEn": "The Use of Knowledge in Society", "yearDisplay": "1945", "noteZh": "提出分散知识问题，解释价格机制如何协调个人无法集中掌握的信息。" },
    { "id": "hayek-constitution-liberty", "philosopherId": "hayek", "titleZh": "《自由宪章》", "titleEn": "The Constitution of Liberty", "yearDisplay": "1960", "noteZh": "系统阐述自由、法治、传统演化和有限政府之间的关系。" },
    { "id": "hayek-law-legislation-liberty", "philosopherId": "hayek", "titleZh": "《法律、立法与自由》", "titleEn": "Law, Legislation and Liberty", "yearDisplay": "1973–1979", "noteZh": "区分演化法秩序和建构性立法，深化自发秩序与规则治理理论。" },
    { "id": "hayek-fatal-conceit", "philosopherId": "hayek", "titleZh": "《致命的自负》", "titleEn": "The Fatal Conceit", "yearDisplay": "1988", "noteZh": "批判理性建构主义自负，强调文明秩序依赖演化规则和扩展合作。" },

    { "id": "schmitt-political-theology", "philosopherId": "schmitt", "titleZh": "《政治神学》", "titleEn": "Political Theology", "originalTitle": "Politische Theologie", "yearDisplay": "1922", "noteZh": "提出主权者是决定例外状态者，并分析现代国家概念的神学结构。" },
    { "id": "schmitt-concept-political", "philosopherId": "schmitt", "titleZh": "《政治的概念》", "titleEn": "The Concept of the Political", "originalTitle": "Der Begriff des Politischen", "yearDisplay": "1932", "noteZh": "以敌友区分定义政治，形成反自由主义政治理论中最具争议的核心命题。" },
    { "id": "schmitt-constitutional-theory", "philosopherId": "schmitt", "titleZh": "《宪法学说》", "titleEn": "Constitutional Theory", "originalTitle": "Verfassungslehre", "yearDisplay": "1928", "noteZh": "讨论宪法、制宪权、民主同质性和自由法治要素之间的张力。" },
    { "id": "schmitt-crisis-parliamentary-democracy", "philosopherId": "schmitt", "titleZh": "《议会制民主的危机》", "titleEn": "The Crisis of Parliamentary Democracy", "yearDisplay": "1923", "noteZh": "批判议会制公开讨论和自由主义程序，体现其反议会主义政治立场。" },
    { "id": "schmitt-legality-legitimacy", "philosopherId": "schmitt", "titleZh": "《合法性与正当性》", "titleEn": "Legality and Legitimacy", "originalTitle": "Legalität und Legitimität", "yearDisplay": "1932", "noteZh": "分析魏玛宪制危机中合法程序和政治正当性之间的危险断裂。" },

    { "id": "croce-aesthetic-expression", "philosopherId": "croce", "titleZh": "《作为表现科学的美学》", "titleEn": "Aesthetic as Science of Expression", "originalTitle": "Estetica come scienza dell'espressione", "yearDisplay": "1902", "noteZh": "把艺术理解为直觉和表现的统一，确立克罗齐美学的基础。" },
    { "id": "croce-logic-pure-concept", "philosopherId": "croce", "titleZh": "《作为纯概念科学的逻辑学》", "titleEn": "Logic as the Science of the Pure Concept", "yearDisplay": "1909", "noteZh": "讨论概念、判断和精神活动的逻辑结构，连接其美学与历史哲学。" },
    { "id": "croce-theory-history-historiography", "philosopherId": "croce", "titleZh": "《历史编纂的理论与历史》", "titleEn": "Theory and History of Historiography", "yearDisplay": "1917", "noteZh": "把历史理解为现实精神的自我认识，反对机械实证主义史学。" },
    { "id": "croce-history-liberty", "philosopherId": "croce", "titleZh": "《历史作为自由的故事》", "titleEn": "History as the Story of Liberty", "yearDisplay": "1938", "noteZh": "以自由作为历史理解的核心范畴，表达反法西斯自由主义史观。" },
    { "id": "croce-philosophy-vico", "philosopherId": "croce", "titleZh": "《詹巴蒂斯塔·维柯的哲学》", "titleEn": "The Philosophy of Giambattista Vico", "yearDisplay": "1911", "noteZh": "推动维柯在现代思想中的复兴，把历史知识和人造世界问题重新置于中心。" }
  ]
}
