    { "id": "hayek", "names": { "zh": "哈耶克", "en": "Friedrich Hayek" }, "life": { "birth": 1899, "death": 1992, "display": "1899—1992" }, "civilization": "western_modern", "traditions": ["classical_liberalism", "political_economy", "social_epistemology"], "periods": ["expansion_d3"], "themes": ["politics", "knowledge", "freedom"], "keywordsZh": ["自发秩序", "知识问题", "法治", "计划批判", "市场秩序"], "oneLineZh": "以分散知识和自发秩序理论批判计划理性，并重构自由主义法治论。", "influenceWeight": 2, "reviewStatus": "draft", "summaryZh": "哈耶克认为社会知识分散在个体和价格信号中，计划经济无法集中处理这种知识，法治和自发秩序因此成为自由的制度条件。", "works": ["hayek-road-serfdom", "hayek-use-knowledge", "hayek-constitution-liberty", "hayek-law-legislation-liberty", "hayek-fatal-conceit"], "sourceNotes": [{ "label": "Primary corpus note", "url": "https://plato.stanford.edu/entries/hayek/", "noteZh": "以哈耶克知识问题、自由宪制和自发秩序文本为核心；二手资料只用于核对关系线。" }] },
