    { "id": "gramsci-dussel-reception", "from": "gramsci", "to": "dussel", "type": "reception", "strength": 1, "confidence": "medium", "themeIds": ["politics", "freedom"], "noteZh": "杜塞尔等解放哲学语境可接收葛兰西霸权和被压迫者政治组织问题，用于分析依附、文化和解放主体。", "reviewStatus": "draft" },
