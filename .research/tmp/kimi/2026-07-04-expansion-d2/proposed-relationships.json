    { "id": "weber-lukacs-critique", "from": "weber", "to": "lukacs", "type": "critique", "strength": 1, "confidence": "medium", "themeIds": ["politics", "knowledge"], "noteZh": "卢卡奇的物化分析与韦伯理性化诊断共享现代抽象支配问题，但他把这种诊断转入资本主义总体性批判。", "reviewStatus": "draft" },
    { "id": "lukacs-horkheimer-influence", "from": "lukacs", "to": "horkheimer", "type": "influence", "strength": 2, "confidence": "medium", "themeIds": ["politics", "knowledge"], "noteZh": "卢卡奇的物化和总体性问题为早期法兰克福学派提供重要背景，影响其对资本主义理性和文化形式的批判。", "reviewStatus": "draft" },
