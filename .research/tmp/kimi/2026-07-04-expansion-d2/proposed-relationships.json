    { "id": "lukacs-bloch-shared_problem", "from": "lukacs", "to": "bloch", "type": "shared_problem", "strength": 1, "confidence": "medium", "themeIds": ["politics", "aesthetics"], "noteZh": "卢卡奇和布洛赫同属西方马克思主义语境，都关注艺术和历史可能性，但前者强调总体性与现实主义，后者强调希望和乌托邦。", "reviewStatus": "draft" }
