    { "id": "bloch-benjamin-shared_problem", "from": "bloch", "to": "benjamin", "type": "shared_problem", "strength": 2, "confidence": "medium", "themeIds": ["religion", "politics"], "noteZh": "布洛赫和本雅明都把马克思主义、弥赛亚意象和历史救赎问题交织起来，但布洛赫更系统地阐发希望和乌托邦。", "reviewStatus": "draft" },
