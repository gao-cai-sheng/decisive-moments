    { "id": "tocqueville-mill-reception", "from": "tocqueville", "to": "mill", "type": "reception", "strength": 2, "confidence": "high", "themeIds": ["politics", "freedom"], "noteZh": "密尔积极评论托克维尔的民主分析，并在自由、代议制和多数压力问题上与其形成持续对话。", "reviewStatus": "draft" },
    { "id": "rousseau-tocqueville-shared_problem", "from": "rousseau", "to": "tocqueville", "type": "shared_problem", "strength": 2, "confidence": "medium", "themeIds": ["politics", "freedom"], "noteZh": "二者都面对民主主权和自由的关系，但卢梭强调公意形成，托克维尔强调平等条件下的社会习俗和制度缓冲。", "reviewStatus": "draft" },
    { "id": "tocqueville-arendt-shared_problem", "from": "tocqueville", "to": "arendt", "type": "shared_problem", "strength": 1, "confidence": "medium", "themeIds": ["politics", "freedom"], "noteZh": "托克维尔的结社和地方自治分析可与阿伦特对公共行动、革命传统和公民自由的关注形成共享问题。", "reviewStatus": "draft" },
    { "id": "tocqueville-habermas-shared_problem", "from": "tocqueville", "to": "habermas", "type": "shared_problem", "strength": 1, "confidence": "medium", "themeIds": ["politics", "language"], "noteZh": "托克维尔关注民主社会中的舆论和结社，哈贝马斯关注公共领域和交往理性，二者都追问现代自由的社会条件。", "reviewStatus": "draft" },
    { "id": "tocqueville-weber-shared_problem", "from": "tocqueville", "to": "weber", "type": "shared_problem", "strength": 1, "confidence": "medium", "themeIds": ["politics"], "noteZh": "托克维尔和韦伯都分析现代社会中行政集中、理性化和个人自由的紧张关系，但理论语言和历史材料不同。", "reviewStatus": "draft" },

    { "id": "marx-gramsci-reception", "from": "marx", "to": "gramsci", "type": "reception", "strength": 3, "confidence": "high", "themeIds": ["politics", "freedom"], "noteZh": "葛兰西继承马克思的历史实践和阶级分析，同时把革命策略转向霸权、市民社会和文化领导权问题。", "reviewStatus": "draft" },
    { "id": "gramsci-lukacs-shared_problem", "from": "gramsci", "to": "lukacs", "type": "shared_problem", "strength": 2, "confidence": "medium", "themeIds": ["politics", "knowledge"], "noteZh": "二者都在西方马克思主义中处理意识、阶级和文化中介问题；葛兰西偏霸权组织，卢卡奇偏物化和总体性。", "reviewStatus": "draft" },
