      {
        "id": "zhuangzi:problem:001",
        "titleZh": "逍遥与无待自由",
        "questionZh": "庄子如何理解真正的自由？逍遥为何意味着不依赖外在功名和固定身份？",
        "summaryZh": "庄子的自由不是外在权利或政治地位，而是摆脱成心、功名、役物和世俗评价束缚的精神逍遥。无待、心斋、坐忘等修养方法共同指向与道相通的开放状态。",
        "themeIds": [
          "freedom"
        ],
        "weight": 1,
        "claims": [
          {
            "id": "zhuangzi:claim:001",
            "titleZh": "逍遥在于无待",
            "claimZh": "庄子认为真正的逍遥不依赖外在功名、地位或他者认可，而是内心不受束缚的状态。",
            "explanationZh": "鲲鹏寓言展示大小之辨并不是最终标准；至人、神人、圣人之所以逍遥，是因为不再以世俗尺度确认自身。",
            "themeIds": [
              "freedom"
            ],
            "weight": 2,
            "evidence": [
              {
                "id": "zhuangzi:evidence:001",
                "titleZh": "《庄子·逍遥游》论至人无己",
                "summaryZh": "《逍遥游》以至人无己、神人无功、圣人无名说明最高自由不依赖功名和社会认可，而在于摆脱外在评价。",
                "source": {
                  "workId": "zhuangzi-primary-work",
                  "locator": "《庄子·逍遥游》：至人无己段",
                  "publicDomainExcerptZh": "至人无己，神人无功，圣人无名。",
                  "excerptStatus": "public_domain"
                }
              },
              {
                "id": "zhuangzi:evidence:002",
                "titleZh": "《庄子·人间世》论心斋",
                "summaryZh": "颜回问心斋一段把自由修养放在虚静和去成见之中，说明无待并非逃离世界，而是改变心与物的关系。",
                "source": {
                  "workId": "zhuangzi-primary-work",
                  "locator": "《庄子·人间世》：颜回问心斋段",
                  "publicDomainExcerptZh": "若一志，无听之以耳而听之以心，无听之以心而听之以气。唯道集虚。虚者，心斋也。",
                  "excerptStatus": "public_domain"
                }
              }
            ]
          },
          {
            "id": "zhuangzi:claim:005",
            "titleZh": "心斋以虚静解除成见",
            "claimZh": "庄子把心斋视为通向自由的修养方法，通过虚静减少成见、欲望和功利计算对心的占据。",
            "explanationZh": "心斋不是消极空白，而是让心不被固定判断占据，从而更能顺应复杂处境。",
            "themeIds": [
              "freedom",
              "ethics"
            ],
            "weight": 1,
