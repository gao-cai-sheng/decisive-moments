              },
              {
                "id": "zhuangzi:evidence:004",
                "titleZh": "《庄子·齐物论》论言非吹也",
                "summaryZh": "《齐物论》讨论言说和风吹之别，显示语言虽有意义活动，却总带着立场和未定性，不能直接固定终极实在。",
                "source": {
                  "workId": "zhuangzi-primary-work",
                  "locator": "《庄子·齐物论》：言非吹也段",
                  "publicDomainExcerptZh": "言非吹也，言者有言，其所言者特未定也。果有言邪？其未尝有言邪？",
                  "excerptStatus": "public_domain"
