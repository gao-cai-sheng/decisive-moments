              {
                "id": "zhuangzi:evidence:005",
                "titleZh": "《庄子·人间世》论虚者心斋",
                "summaryZh": "《人间世》把心斋解释为虚以待物，要求主体暂缓自我意图和成见，以便在危险人世中保持通达。",
                "source": {
                  "workId": "zhuangzi-primary-work",
                  "locator": "《庄子·人间世》：虚者心斋也段",
                  "publicDomainExcerptZh": "气也者，虚而待物者也。唯道集虚。虚者，心斋也。",
                  "excerptStatus": "public_domain"
