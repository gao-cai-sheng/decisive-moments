        "claims": [
          {
            "id": "levinas:claim:003",
            "titleZh": "言说先于被说内容",
            "claimZh": "列维纳斯认为，语言不只是传递信息的工具，更是在言说中向他者开放的伦理姿态。",
            "explanationZh": "该命题把语言从符号系统扩展为关系事件，说明表达本身已经包含伦理方向。",
            "themeIds": [
              "language",
              "ethics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "levinas:evidence:005",
                "titleZh": "言说区分依据",
                "summaryZh": "《别于存在或超越本质》区分“言说”和“被说”，指出活的言说表现为面向他者的开放。",
                "source": {
