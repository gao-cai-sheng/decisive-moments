      {
        "id": "levinas:problem:001",
        "titleZh": "伦理关系为何先于理论分类？",
        "questionZh": "列维纳斯如何围绕“伦理关系为何先于理论分类？”建立其思想问题？",
        "summaryZh": "列维纳斯把与他者的相遇置于哲学起点，强调主体首先面对回应责任，而不是先完成中立认识。",
        "themeIds": [
          "ethics",
          "religion"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "levinas:claim:001",
            "titleZh": "他者面容开启伦理要求",
            "claimZh": "列维纳斯认为，他者面容不是普通对象属性，而是在相遇中向主体提出伦理要求。",
            "explanationZh": "该命题把伦理从规则应用转向相遇结构，说明责任先于对他者的对象化理解。",
            "themeIds": [
              "ethics",
              "language"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "levinas:evidence:001",
                "titleZh": "面容相遇依据",
                "summaryZh": "《总体与无限》关于面容的讨论说明，他者并非首先作为可掌握对象出现，而是在相遇中要求主体作出回应。",
                "source": {
                  "workId": "levinas-primary-work",
                  "locator": "《总体与无限》第三部第一节第3段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "levinas:evidence:002",
                "titleZh": "伦理要求依据",
                "summaryZh": "同节进一步把面容经验与命令性要求联系起来，显示伦理关系不是从抽象原则推导出来的附加结论。",
                "source": {
                  "workId": "levinas-primary-work",
                  "locator": "《总体与无限》第三部第一节第7段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "levinas:claim:002",
            "titleZh": "主体在责任中被规定",
            "claimZh": "列维纳斯主张，主体不是先有完全自足身份再选择责任，而是在责任关系中被规定。",
            "explanationZh": "该命题改变现代主体观，把自我理解为被他者召唤和要求的伦理位置。",
