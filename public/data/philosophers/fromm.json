  "thoughtSystem": {
    "problems": [
      {
        "id": "fromm:problem:001",
        "titleZh": "自由的负担与逃避",
        "questionZh": "弗洛姆如何解释现代个人既追求自由又逃避自由的心理机制？",
        "summaryZh": "弗洛姆认为现代人摆脱传统束缚后获得形式自由，却因孤立、焦虑和无力感转向威权、破坏或自动顺从。",
        "themeIds": [
          "freedom",
          "politics"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "fromm:claim:001",
            "titleZh": "现代自由伴随孤立焦虑",
            "claimZh": "弗洛姆认为现代自由切断旧共同体纽带后，也使个人暴露在孤立、无意义和无力感中。",
            "explanationZh": "自由因此不是简单解放状态，而是需要人格成熟和社会条件支持的困难任务。",
            "themeIds": [
              "freedom",
              "ethics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "fromm:evidence:001",
                "titleZh": "《逃避自由》论个体化双重性",
                "summaryZh": "文本把个体化解释为既带来独立也制造孤立的历史过程，说明现代自由内含焦虑结构，由此解释自由为何可能转成对安全和归属的渴望。",
                "source": {
                  "workId": "fromm-escape-freedom",
                  "locator": "chapters on individuation and freedom",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "fromm:evidence:002",
                "titleZh": "《逃避自由》论无力感",
                "summaryZh": "弗洛姆把现代人的无力感和孤独感作为理解威权依恋的重要心理社会前提，为后文威权主义、破坏性和自动顺从三机制铺垫。",
                "source": {
                  "workId": "fromm-escape-freedom",
                  "locator": "chapter on mechanisms of escape",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
