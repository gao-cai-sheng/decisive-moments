                "id": "dignaga:evidence:008",
                "titleZh": "佛教量论传统的反独断功能",
                "summaryZh": "后世研究常把陈那量论理解为反击外道常我、共相和语言实在论的重要理性工具，并服务佛教破执。",
                "source": {
                  "workId": "dignaga-pramanasamuccaya",
                  "locator": "Secondary account of Buddhist epistemology and anti-essentialism",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          }
