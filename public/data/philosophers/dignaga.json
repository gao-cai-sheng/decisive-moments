    "dignaga-pramanasamuccaya",
    "dignaga-alambanapariksa",
    "dignaga-hetucakra",
    "dignaga-nyayamukha",
    "dignaga-trikala-pariksa",
    "dignaga-apoha-treatise"
  ],
  "sourceNotes": [
    {
      "label": "secondary",
      "noteZh": "用于核对陈那生平、量论、现量/比量、因明三相和遮诠理论。"
    },
    {
      "label": "primary",
      "noteZh": "以《集量论》《观所缘缘论》《因轮论》《因明正理门论》等作为真实 works。"
    }
  ],
  "thoughtSystem": {
    "problems": [
      {
        "id": "dignaga:problem:001",
        "titleZh": "有效认知为什么只有现量与比量？",
        "questionZh": "陈那如何用二量框架重塑印度佛教认识论？",
        "summaryZh": "陈那把有效认知限定为现量和比量，分别对应不可概念化的自相与概念推理把握的共相，从而重写知识来源分类。",
        "themeIds": [
          "knowledge",
          "metaphysics"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "dignaga:claim:001",
            "titleZh": "二量对应两类对象",
            "claimZh": "现量把握自相，比量处理共相；除此之外的知识来源要么可还原，要么不能独立成立。",
            "explanationZh": "这个框架压缩并重组了印度哲学关于知觉、推理、譬喻和圣言的争论，成为佛教量论入口。",
            "themeIds": [
              "knowledge",
              "metaphysics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "dignaga:evidence:001",
                "titleZh": "《集量论》的二量开端",
                "summaryZh": "《集量论》开篇系统提出现量和比量两种有效认知，并把对象区分为自相与共相，建立量论总纲。",
                "source": {
                  "workId": "dignaga-pramanasamuccaya",
                  "locator": "Pramanasamuccaya, chapter 1 on perception and inference",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "dignaga:evidence:002",
                "titleZh": "二量说的后世概括",
                "summaryZh": "现代研究通常把陈那视为佛教逻辑认识论传统奠基者，其二量说成为法称等后继者的基本框架。",
                "source": {
                  "workId": "dignaga-pramanasamuccaya",
                  "locator": "Secondary account of Dignaga's two-pramana theory",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "dignaga:claim:002",
            "titleZh": "现量排除概念构造",
            "claimZh": "真正现量不是带名称和类别的判断，而是尚未被概念结构加工的直接呈现。",
            "explanationZh": "这使陈那能够区分感知事件与随后的语言分类，并为佛教反实体化立场提供认识论工具。",
