      {
        "id": "dignaga:problem:002",
        "titleZh": "推理怎样避免形式空转？",
        "questionZh": "陈那如何用因明结构和因三相确定有效理由？",
        "summaryZh": "陈那通过因轮和三相标准分析理由与所立之间的关系，使推理既有形式约束，也服务于破除错误见解。",
        "themeIds": [
          "knowledge",
          "language"
        ],
        "weight": 2,
        "claims": [
          {
            "id": "dignaga:claim:003",
            "titleZh": "有效因必须满足分布条件",
            "claimZh": "一个理由必须在论题中出现、在同品中出现并在异品中不出现，才有资格支持推论。",
            "explanationZh": "因三相把辩论中的说服理由形式化，防止只是语言相似或权威声称冒充证明。",
            "themeIds": [
              "knowledge",
              "language"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "dignaga:evidence:005",
                "titleZh": "《因轮论》的九句因",
                "summaryZh": "《因轮论》以九种理由分布展示何种因能成立推理，推动印度逻辑从辩论术走向形式分析。",
                "source": {
                  "workId": "dignaga-hetucakra",
                  "locator": "Hetucakra, wheel of reasons and valid signs",
                  "excerptStatus": "summary_only"
