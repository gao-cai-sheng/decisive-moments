      {
        "id": "russell:problem:001",
        "titleZh": "逻辑分析如何澄清知识？",
        "questionZh": "罗素如何围绕“逻辑分析如何澄清知识？”建立其思想问题？",
        "summaryZh": "罗素通过逻辑主义、关系逻辑和摹状词理论，把哲学任务理解为澄清命题形式和知识根据。",
        "themeIds": [
          "knowledge",
          "language"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "russell:claim:001",
            "titleZh": "数学可由逻辑关系重建",
            "claimZh": "罗素主张，数学基础应通过逻辑概念和关系理论来重建，而不是依赖心理直观。",
            "explanationZh": "该命题推动二十世纪分析哲学的逻辑转向，试图以形式结构替代心理主义和直觉主义解释。",
            "themeIds": [
              "knowledge"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "russell:evidence:001",
                "titleZh": "逻辑主义依据",
                "summaryZh": "《数学原理》导论把数学与逻辑的关系作为核心问题，说明数学命题可在逻辑概念和推理规则中获得系统重建。",
                "source": {
                  "workId": "russell-primary-work",
                  "locator": "《数学原理》导论“数学与逻辑的关系”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "russell:evidence:007",
                "titleZh": "类型理论依据",
                "summaryZh": "《数学原理》用类型理论回应集合悖论，说明逻辑基础必须同时处理数学构造能力和自指混乱的限制。",
                "source": {
                  "workId": "russell-primary-work",
                  "locator": "《数学原理》导论“恶性循环原则和类型理论”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "russell:claim:002",
            "titleZh": "摹状词分析消解虚假对象",
            "claimZh": "罗素认为，许多表面指称短语并不真正指称对象，通过逻辑分析可避免承诺不存在实体。",
            "explanationZh": "该命题把哲学问题转化为语言逻辑形式问题，影响后来的指称理论和分析方法。",
            "themeIds": [
              "language",
              "knowledge"
            ],
            "weight": 2,
            "evidence": [
              {
                "id": "russell:evidence:002",
                "titleZh": "摹状词理论依据",
                "summaryZh": "《论指称》通过“现任法国国王”类摹状词分析，说明表面主词并不必然带来对相应对象的本体论承诺。",
                "source": {
                  "workId": "russell-primary-work",
                  "locator": "《论指称》“现任法国国王”例证段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "russell:evidence:008",
                "titleZh": "分析命题结构依据",
                "summaryZh": "《论指称》把摹状词解释为量化结构的一部分，显示语法表面与逻辑形式不同，哲学混乱常来自二者混同。",
                "source": {
                  "workId": "russell-primary-work",
                  "locator": "《论指称》“摹状词的量化分析”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          }
        ]
