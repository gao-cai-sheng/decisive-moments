      {
        "id": "confucius-ren",
        "titleZh": "仁与人伦",
        "questionZh": "人与人之间的根本德性是什么，如何从亲近关系扩展到公共秩序？",
        "summaryZh": "孔子以仁作为伦理生活的核心，把亲亲、忠恕和成人之道连成一条修养路径。",
        "themeIds": [
          "ethics",
          "politics"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "confucius-ren-relational",
            "titleZh": "仁从关系中展开",
            "claimZh": "仁不是抽象原则，而是在具体人伦关系中持续实践的德性。",
            "explanationZh": "孔子的仁从亲近者开始，但并不停止于家庭，而是通过修养扩展为待人接物的普遍尺度。",
            "themeIds": [
              "ethics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "confucius-ren-analects",
                "titleZh": "《论语》中的仁",
                "summaryZh": "《论语》多处以爱人、克己复礼、忠恕等方式解释仁的实践面向，强调关系中的德性展开。",
                "source": {
                  "workId": "confucius-primary-work",
                  "locator": "《论语·颜渊》：樊迟问仁章",
                  "publicDomainExcerptZh": "樊迟问仁。子曰：爱人。",
                  "excerptStatus": "public_domain"
                }
              },
              {
                "id": "confucius-ren-second-analects",
                "titleZh": "己欲立而立人",
                "summaryZh": "《论语·雍也》以己欲立而立人、己欲达而达人说明仁的扩展性，连接自身修养与成就他人。",
                "source": {
                  "workId": "confucius-primary-work",
                  "locator": "《论语·雍也》：夫仁者己欲立而立人章",
                  "publicDomainExcerptZh": "夫仁者，己欲立而立人，己欲达而达人。",
                  "excerptStatus": "public_domain"
