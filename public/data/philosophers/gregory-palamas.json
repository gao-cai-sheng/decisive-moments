            "evidence": [
              {
                "id": "gregory-palamas:evidence:003",
                "titleZh": "心被称为理性能力的身体器官",
                "summaryZh": "第一组第二篇说明心是理性能力的首要身体器官，静修者把外散的心智收回心内，是为了守望和纠正理性。",
                "sourceIds": [
