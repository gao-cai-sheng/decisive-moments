      "noteZh": "辅助核验晚期拜占庭哲学、静修主义与东正教思想传统位置。"
    }
  ],
  "thoughtSystem": {
    "problems": [
      {
        "id": "gregory-palamas:problem:001",
        "titleZh": "静修为何需要论证？",
        "questionZh": "帕拉马斯怎样在论争中为静修者的身心祈祷、恩典智慧和经验知识辩护？",
        "summaryZh": "帕拉马斯不是简单反理性，而是在 Barlaam 的批评压力下区分世俗学问、自然智慧和从恩典来的神圣智慧。他为静修者的身心方法辩护，说明身体不是祈祷的障碍；心、理智和身体都能被恩典重新组织为朝向神的器官。",
        "themeIds": [
          "religion",
          "knowledge"
        ],
        "weight": 3,
        "sourceIds": [
          "S008",
          "S009",
          "S010"
        ],
        "claims": [
          {
            "id": "gregory-palamas:claim:001",
            "titleZh": "世俗智慧不能替代恩典智慧",
            "claimZh": "帕拉马斯承认外在学问有自然价值，却否认它能净化灵魂或带来救恩性的神知识。",
            "explanationZh": "他反对把希腊学问当作灵魂净化的必要条件；真正的神圣智慧来自恩典、祈祷和圣灵的改变。",
            "themeIds": [
              "knowledge",
              "religion"
            ],
            "weight": 3,
            "sourceIds": [
              "S009"
            ],
            "evidence": [
              {
                "id": "gregory-palamas:evidence:001",
