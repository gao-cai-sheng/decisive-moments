        "weight": 3,
        "claims": [
          {
            "id": "arendt:claim:001",
            "titleZh": "行动显现是谁",
            "claimZh": "阿伦特主张，人通过言说和行动在公共世界中显现独特身份，政治自由由此发生。",
            "explanationZh": "该命题把政治从统治技术转回共同显现和开端能力，强调复数性。",
            "themeIds": [
