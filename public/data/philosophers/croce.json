      {
        "id": "croce:problem:001",
        "titleZh": "表现美学与直觉",
        "questionZh": "克罗齐如何把艺术理解为直觉和表现的统一？",
        "summaryZh": "克罗齐反对把艺术化约为概念、道德或技术，把艺术本质定位为直觉在表现中的形成。",
        "themeIds": [
          "aesthetics",
          "knowledge"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "croce:claim:001",
            "titleZh": "艺术是直觉表现",
            "claimZh": "克罗齐认为艺术不是模仿对象或传达概念，而是直觉和表现不可分的精神活动。",
            "explanationZh": "这使美学从外在规则和题材评价转向表现形式本身，影响现代美学和文学批评。",
            "themeIds": [
              "aesthetics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "croce:evidence:001",
                "titleZh": "《美学》论直觉与表现同一",
                "summaryZh": "文本把艺术界定为直觉即表现，认为未被表现的直觉不是完整艺术活动，从而把艺术创造放在精神活动内部，而非外部技巧。",
                "source": {
                  "workId": "croce-aesthetic-expression",
                  "locator": "opening chapters on intuition and expression",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "croce:evidence:002",
                "titleZh": "《美学》批判艺术分类外在化",
                "summaryZh": "克罗齐反对用题材、媒介或道德目的外在分类艺术，强调表现活动的内在统一，使美学批评转向作品表现本身，而非题材清单。",
                "source": {
                  "workId": "croce-aesthetic-expression",
                  "locator": "chapters on criticism of genres and external classifications",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
