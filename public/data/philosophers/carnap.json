      {
        "id": "carnap:problem:001",
        "titleZh": "哲学命题如何获得逻辑澄清？",
        "questionZh": "卡尔纳普如何围绕“哲学命题如何获得逻辑澄清？”建立其思想问题？",
        "summaryZh": "卡尔纳普把哲学工作理解为语言与逻辑句法的澄清，反对把形而上学伪命题当作知识。",
        "themeIds": [
          "language",
          "knowledge"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "carnap:claim:001",
            "titleZh": "哲学转向语言分析",
            "claimZh": "卡尔纳普主张，许多传统哲学争论并非事实问题，而是语言框架和表达规则未被澄清。",
            "explanationZh": "该命题使哲学成为概念语言的规范分析，减少不受检验的形而上学断言。",
            "themeIds": [
              "language",
              "knowledge"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "carnap:evidence:001",
                "titleZh": "逻辑句法依据",
                "summaryZh": "《语言的逻辑句法》把哲学任务定位为对科学语言的逻辑句法研究，强调哲学应澄清表达规则而非提出超经验事实。",
                "source": {
                  "workId": "carnap-primary-work",
                  "locator": "《语言的逻辑句法》导论“哲学作为逻辑句法”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "carnap:evidence:007",
                "titleZh": "容许原则依据",
                "summaryZh": "《语言的逻辑句法》提出可按目的自由选择语言形式的容许原则，说明哲学争论常可转化为框架规则选择。",
                "source": {
                  "workId": "carnap-primary-work",
                  "locator": "《语言的逻辑句法》第17节“容许原则”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
