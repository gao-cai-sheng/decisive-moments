        "id": "camus:problem:001",
        "titleZh": "荒诞如何从意义追问中产生？",
        "questionZh": "加缪如何围绕“荒诞如何从意义追问中产生？”建立其思想问题？",
        "summaryZh": "加缪把荒诞理解为人对意义的渴望与沉默世界之间的张力，而非简单虚无主义。",
        "themeIds": [
          "life_death",
          "metaphysics"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "camus:claim:001",
            "titleZh": "荒诞来自人与世界裂缝",
            "claimZh": "加缪主张，荒诞在人的意义要求与世界沉默相遇处产生，而非单纯属于世界或人。",
            "explanationZh": "该命题使人生意义问题摆脱教条答案，同时保留清醒面对现实的伦理要求。",
            "themeIds": [
              "life_death",
              "metaphysics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "camus:evidence:001",
                "titleZh": "荒诞推理依据",
