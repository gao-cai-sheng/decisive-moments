        "claims": [
          {
            "id": "schmitt:claim:001",
            "titleZh": "例外暴露规范秩序的边界",
            "claimZh": "施米特主张主权者是决定例外状态者，因为危机时谁能暂停规范决定了秩序基础。",
            "explanationZh": "这一命题揭示法律规范对政治决定的依赖，但也为威权决断论打开危险空间。",
            "themeIds": [
