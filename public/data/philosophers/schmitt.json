              "justice"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "schmitt:evidence:001",
                "titleZh": "《政治神学》开篇定义主权",
                "summaryZh": "文本以决定例外状态界定主权，说明法秩序在极端危机中依赖不能由普通规范穷尽的决定。",
                "source": {
