    }
  ],
  "thoughtSystem": {
    "problems": [
      {
        "id": "pseudo-dionysius:problem:001",
        "titleZh": "神圣名称如何既能言说又必须受限？",
        "questionZh": "伪狄奥尼修斯如何让神圣名称成为真实神学语言，同时又禁止它越过启示和受造心智能力？",
        "summaryZh": "《神圣名称》的起点不是随意命名，而是给神学语言设定纪律：名称来自圣言所许可的显明，受造心智按自身能力接受照明；肯定名称因此能真实赞颂神为原因，却不能把神的超本质纳入概念把握。",
        "themeIds": [
          "language",
          "religion",
          "knowledge"
        ],
        "weight": 3,
        "sourceIds": [
          "S004"
        ],
        "claims": [
          {
            "id": "pseudo-dionysius:claim:001",
            "titleZh": "神学言说必须服从圣言和能力比例",
            "claimZh": "伪狄奥尼修斯把谈论神的合法性系于圣言启示和心智能力比例，而不是交给人的概念雄辩。",
            "explanationZh": "他并非简单反语言，而是要求语言从启示的光线出发，并承认受造心智只能按自身容量参与不可量度的善。",
            "themeIds": [
              "language",
              "knowledge",
              "religion"
            ],
            "weight": 3,
            "sourceIds": [
              "S004"
            ],
            "evidence": [
              {
                "id": "pseudo-dionysius:evidence:001",
                "titleZh": "神名解释受圣言规则约束",
                "summaryZh": "《神圣名称》开篇规定，关于神的真理不能靠人类智慧的说服术建立，而要按圣言和神学家所传的能力来言说不可言说之事。",
                "sourceIds": [
                  "S004"
                ],
                "source": {
                  "workId": "pseudo-dionysius-divine-names",
                  "locator": "Divine Names, ch. 1, §1",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "pseudo-dionysius:evidence:002",
                "titleZh": "超本质神性不可越启示而思说",
                "summaryZh": "同章第二节明确禁止越过圣言所启示的范围去思考或言说隐藏神性；神的本质知识超出一切受造者，只按许可照明而临近。",
                "sourceIds": [
                  "S004"
                ],
                "source": {
                  "workId": "pseudo-dionysius-divine-names",
                  "locator": "Divine Names, ch. 1, §2",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "pseudo-dionysius:claim:002",
            "titleZh": "肯定名称真实指向神作为万有原因",
            "claimZh": "神圣名称虽不能捕捉神的本质，却能按神向万有的施予、照明和原因性真实地赞颂神。",
            "explanationZh": "他允许称神为善、存在、生命、智慧等，不是因为概念等于神，而是因为万有从神而来并按不同方式参与神的恩赐。",
            "themeIds": [
