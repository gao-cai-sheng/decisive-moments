          "S005"
        ],
        "claims": [
          {
            "id": "pseudo-dionysius:claim:005",
            "titleZh": "万有按自身能力参与善",
            "claimZh": "万物不是以同一种方式拥有神，而是按其存在层级和能力比例参与善所施予的存在、生命、智慧和秩序。",
            "explanationZh": "这种参与论既解释神名为何可说，也解释为何神名不能等同神本质；名称说的是神向万有的施予和万有的回应。",
            "themeIds": [
              "metaphysics",
              "religion"
            ],
            "weight": 3,
            "sourceIds": [
              "S004"
