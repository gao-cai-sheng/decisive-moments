          {
            "id": "pseudo-dionysius:claim:004",
            "titleZh": "否定按与肯定相反的次序运作",
            "claimZh": "伪狄奥尼修斯把肯定和否定安排成相反运动：肯定由高而低展开名称，否定由低而高抽离规定。",
            "explanationZh": "这种方法说明否定不是随口说“神不是一切”，而是有序撤除从感性到理智的规定，直到连否定和定义自身也被超越。",
            "themeIds": [
              "language",
              "metaphysics",
              "knowledge"
            ],
            "weight": 3,
            "sourceIds": [
              "S005"
            ],
            "evidence": [
              {
                "id": "pseudo-dionysius:evidence:007",
                "titleZh": "抽象如雕像剥除遮蔽物",
                "summaryZh": "第二章把否定比作制作雕像时除去遮蔽物；心智从最低事物开始抽离，逐步显出被一切已知之光遮蔽的超本质幽暗。",
                "sourceIds": [
                  "S005"
                ],
                "source": {
                  "workId": "pseudo-dionysius-mystical-theology",
                  "locator": "Mystical Theology, ch. 2",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "pseudo-dionysius:evidence:008",
                "titleZh": "最高处言说收缩为无声",
                "summaryZh": "第三章比较肯定神学、神名神学和象征神学，指出越向上升，表达越被限制；完全上升之后，言说与概念都归于无声。",
                "sourceIds": [
                  "S005"
                ],
                "source": {
                  "workId": "pseudo-dionysius-mystical-theology",
                  "locator": "Mystical Theology, ch. 3",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "pseudo-dionysius:problem:003",
        "titleZh": "参与如何把万物、名称和无知连起来？",
        "questionZh": "如果神超越一切名称和知识，受造物又如何真实参与神，并以名称显示这种参与？",
        "summaryZh": "伪狄奥尼修斯的关键不是在肯定与否定之间二选一，而是把二者安放在参与结构中。万有因善而存在、运动、向善；神名描述这些施予和回归，却始终承认神在自身中超过所施予的一切。",
        "themeIds": [
          "metaphysics",
          "religion",
          "knowledge"
        ],
