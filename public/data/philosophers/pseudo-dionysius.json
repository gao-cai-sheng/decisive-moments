            ],
            "evidence": [
              {
                "id": "pseudo-dionysius:evidence:003",
                "titleZh": "圣言光照引向赞颂源头",
                "summaryZh": "《神圣名称》第一章第三节说明神圣诗歌按人的能力照明心智，使人赞颂一切圣显明之光的源头，而不是占有神本身。",
                "sourceIds": [
                  "S004"
                ],
                "source": {
                  "workId": "pseudo-dionysius-divine-names",
                  "locator": "Divine Names, ch. 1, §3",
                  "excerptStatus": "summary_only"
