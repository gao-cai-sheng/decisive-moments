            "id": "buber:claim:001",
            "titleZh": "我—你关系使自我真实显现",
            "claimZh": "布伯主张，自我不是孤立实体，而是在面对“你”的直接关系中获得真实存在。",
            "explanationZh": "该命题把主体性从内在自足转向相遇事件，强调关系先于抽象个体定义。",
            "themeIds": [
              "ethics",
              "metaphysics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "buber:evidence:001",
                "titleZh": "基本词依据",
