      {
        "id": "buber:problem:001",
        "titleZh": "人如何在关系中成为自我？",
        "questionZh": "布伯如何围绕“人如何在关系中成为自我？”建立其思想问题？",
        "summaryZh": "布伯把人的存在理解为关系性事件，区分我—你和我—它两种基本态度。",
        "themeIds": [
          "ethics",
          "language"
        ],
        "weight": 3,
        "claims": [
