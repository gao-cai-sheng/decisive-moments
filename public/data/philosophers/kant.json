      {
        "id": "kant-knowledge",
        "titleZh": "知识何以可能",
        "questionZh": "经验知识如何可能，它依赖对象本身，还是也依赖主体的认识形式？",
        "summaryZh": "康德把认识理解为感性形式、知性范畴和经验材料共同构成的活动。",
        "themeIds": [
          "knowledge",
          "metaphysics"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "kant-synthetic-apriori",
            "titleZh": "先天综合判断",
            "claimZh": "数学和自然科学中的某些必然知识既扩展内容，又不完全来自经验。",
            "explanationZh": "先天综合判断问题推动康德追问主体形式如何使经验对象成为可认识对象。",
            "themeIds": [
              "knowledge",
              "metaphysics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "kant-critique-pure-reason",
                "titleZh": "《纯粹理性批判》",
                "summaryZh": "第一批判以先天综合判断为入口，分析数学、自然科学和形而上学的可能性。",
                "source": {
                  "workId": "kant-primary-work",
                  "locator": "导论",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "kant-forms-categories",
            "titleZh": "空间时间与范畴",
            "claimZh": "空间和时间是感性直观形式，范畴是经验对象可被判断的知性条件。",
            "explanationZh": "康德不是说主体任意制造世界，而是说对象作为经验对象必须经过认识形式的组织。",
            "themeIds": [
              "knowledge"
            ],
            "weight": 3,
