      {
        "id": "plato-forms",
        "titleZh": "理念与真实",
        "questionZh": "真正的存在是可感事物，还是高于经验世界的理念？",
        "summaryZh": "柏拉图区分可感世界与理念世界，以解释知识、价值和秩序为何不只是流变经验。",
        "themeIds": [
          "metaphysics",
          "knowledge"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "plato-forms-intelligible",
            "titleZh": "理念高于可感事物",
            "claimZh": "可感事物不断变化，真正可知的是稳定的理念结构。",
            "explanationZh": "理念论让知识拥有稳定对象，也让正义、美和善不只是个人意见。",
            "themeIds": [
              "metaphysics",
              "knowledge"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "plato-forms-republic",
                "titleZh": "《理想国》中的理念讨论",
                "summaryZh": "《理想国》以太阳、线段和洞穴等比喻说明可见世界与可知世界的层级差别。",
                "source": {
                  "workId": "plato-primary-work",
                  "locator": "《理想国》中卷",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "plato-good-source",
            "titleZh": "善的理念是最高原则",
            "claimZh": "善的理念使知识对象可知，也使认识者能够认识。",
            "explanationZh": "善不是普通价值之一，而是让真理、存在和秩序能够显现的最高原则。",
            "themeIds": [
              "metaphysics",
              "ethics"
            ],
            "weight": 3,
            "evidence": [
