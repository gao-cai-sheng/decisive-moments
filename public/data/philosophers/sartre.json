      {
        "id": "sartre:problem:001",
        "titleZh": "存在为何先于本质？",
        "questionZh": "萨特如何围绕“存在为何先于本质？”建立其思想问题？",
        "summaryZh": "萨特以存在先于本质说明人没有预设本性，必须在行动中承担自由和责任。",
        "themeIds": [
          "freedom",
          "metaphysics"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "sartre:claim:001",
            "titleZh": "人没有预设本质",
            "claimZh": "萨特主张，人不是按照既定本质被制造出来的对象，而是在存在之后通过行动成为自己。",
            "explanationZh": "该命题把人的定义交给行动和选择，反对以自然本性、神意或社会角色逃避责任。",
            "themeIds": [
              "freedom",
              "metaphysics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "sartre:evidence:001",
                "titleZh": "存在先于本质依据",
                "summaryZh": "《存在主义是一种人道主义》明确提出存在先于本质，说明人首先存在、遭遇自己，然后通过行动定义自身。",
                "source": {
                  "workId": "sartre-primary-work",
                  "locator": "《存在主义是一种人道主义》“存在先于本质”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "sartre:evidence:007",
                "titleZh": "无神处境依据",
                "summaryZh": "同文把无神处境与人的自我立法相连，说明没有预设价值表时，人必须自己承担选择和意义建构。",
                "source": {
                  "workId": "sartre-primary-work",
                  "locator": "《存在主义是一种人道主义》“无神处境和人的责任”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "sartre:claim:002",
            "titleZh": "自由伴随普遍责任",
            "claimZh": "萨特认为，人在选择自身时也在选择一种人的形象，因此自由总伴随责任。",
            "explanationZh": "该命题使自由不再是私人任意，而是对人类形象和他人世界的承担。",
            "themeIds": [
              "freedom",
              "ethics"
            ],
            "weight": 2,
            "evidence": [
              {
                "id": "sartre:evidence:002",
                "titleZh": "选择责任依据",
                "summaryZh": "《存在主义是一种人道主义》说明人在选择自己时也选择人，个人行动因而带有超出私人偏好的责任维度。",
                "source": {
                  "workId": "sartre-primary-work",
                  "locator": "《存在主义是一种人道主义》“选择自己也选择人”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "sartre:evidence:008",
                "titleZh": "焦虑责任依据",
                "summaryZh": "同文以焦虑说明自由选择无法逃避责任，人在没有外部保证时仍必须决定并承担行动后果。",
                "source": {
                  "workId": "sartre-primary-work",
                  "locator": "《存在主义是一种人道主义》“焦虑、遗弃与绝望”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "sartre:problem:002",
        "titleZh": "意识如何以虚无方式存在？",
        "questionZh": "萨特如何围绕“意识如何以虚无方式存在？”建立其思想问题？",
        "summaryZh": "萨特用自在、自为、虚无和自欺分析意识如何超出既定事实并面对自由。",
        "themeIds": [
          "metaphysics",
          "knowledge"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "sartre:claim:003",
            "titleZh": "意识不是物而是超越",
            "claimZh": "萨特主张，自为存在不同于自在存在；意识总是超出自身既定状态而指向可能。",
            "explanationZh": "该命题把意识理解为否定性和超越性活动，而非固定对象或心理容器。",
            "themeIds": [
              "metaphysics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "sartre:evidence:003",
                "titleZh": "自在自为依据",
                "summaryZh": "《存在与虚无》导论和第一部区分自在与自为，说明意识不是封闭物，而是在否定和超越中显现自身。",
                "source": {
                  "workId": "sartre-primary-work",
                  "locator": "《存在与虚无》导论“自在与自为”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "sartre:evidence:009",
                "titleZh": "虚无化依据",
                "summaryZh": "《存在与虚无》关于否定性的分析说明，意识能把事实置于距离中并显现缺席、可能和未然。",
                "source": {
                  "workId": "sartre-primary-work",
                  "locator": "《存在与虚无》第一部第一章“否定性和虚无化”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "sartre:claim:004",
            "titleZh": "自欺是逃避自由",
            "claimZh": "萨特认为，自欺不是简单错误信念，而是意识试图把自己固定为物以逃避自由责任。",
            "explanationZh": "该命题揭示人常把社会角色或事实处境绝对化，以避免面对自身超越性。",
            "themeIds": [
              "freedom",
              "ethics"
            ],
            "weight": 2,
            "evidence": [
              {
                "id": "sartre:evidence:004",
                "titleZh": "自欺分析依据",
                "summaryZh": "《存在与虚无》第一部第二章把自欺描述为意识既知道又遮蔽自身自由的结构，不只是普通错误判断。",
                "source": {
                  "workId": "sartre-primary-work",
                  "locator": "《存在与虚无》第一部第二章“自欺”段",
                  "excerptStatus": "summary_only"
