    "problems": [
      {
        "id": "heidegger:problem:001",
        "titleZh": "存在问题为何被遗忘？",
        "questionZh": "海德格尔如何围绕“存在问题为何被遗忘？”建立其思想问题？",
        "summaryZh": "海德格尔重新提出存在意义问题，区分存在和存在者，并以此在分析作为进入路径。",
        "themeIds": [
          "metaphysics",
          "knowledge"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "heidegger:claim:001",
            "titleZh": "存在不同于存在者",
            "claimZh": "海德格尔主张，存在问题不能被还原为某个最高存在者，必须重建存在与存在者的差异。",
            "explanationZh": "该命题把形而上学的焦点从实体清单转向存在意义，构成其基础存在论的起点。",
            "themeIds": [
              "metaphysics"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "heidegger:evidence:001",
                "titleZh": "存在问题依据",
                "summaryZh": "《存在与时间》导论指出存在意义虽被预设，却长期没有被作为问题本身展开，因此必须重新提出存在之问。",
                "source": {
                  "workId": "heidegger-primary-work",
                  "locator": "《存在与时间》导论第1节“存在问题的必要性”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "heidegger:evidence:007",
                "titleZh": "存在论差异依据",
                "summaryZh": "《存在与时间》导论把存在者研究和存在意义追问区分开来，显示最高存在者不能替代存在本身的问题。",
                "source": {
                  "workId": "heidegger-primary-work",
                  "locator": "《存在与时间》导论第2节“存在问题的形式结构”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "heidegger:claim:002",
            "titleZh": "此在是追问入口",
            "claimZh": "海德格尔认为，能追问存在意义的存在者是此在，分析此在是进入存在问题的方法。",
            "explanationZh": "该命题把存在论研究和人的实际存在方式连接起来，使基础存在论必须从此在分析展开。",
            "themeIds": [
              "metaphysics",
              "knowledge"
            ],
            "weight": 2,
            "evidence": [
              {
                "id": "heidegger:evidence:002",
                "titleZh": "此在优先性依据",
                "summaryZh": "《存在与时间》说明此在在存在问题中具有存在者、存在论和前存在论三重优先性，因而是追问入口。",
                "source": {
                  "workId": "heidegger-primary-work",
                  "locator": "《存在与时间》导论第4节“此在的优先性”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "heidegger:evidence:008",
                "titleZh": "此在分析任务依据",
                "summaryZh": "《存在与时间》导论说明基础存在论必须先分析此在的存在结构，因为此在总已经对存在有所领会。",
                "source": {
                  "workId": "heidegger-primary-work",
                  "locator": "《存在与时间》导论第5节“此在分析作为基础存在论”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "heidegger:problem:002",
        "titleZh": "此在如何总已在世界中？",
        "questionZh": "海德格尔如何围绕“此在如何总已在世界中？”建立其思想问题？",
        "summaryZh": "海德格尔用在世存在、器具性和上手状态说明此在并非孤立主体，而总在实践关联中理解世界。",
        "themeIds": [
          "metaphysics",
          "knowledge"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "heidegger:claim:003",
            "titleZh": "在世存在先于主客对立",
            "claimZh": "海德格尔主张，此在不是孤立主体再面对对象世界，而是总已在有意义的世界关系中活动。",
            "explanationZh": "该命题瓦解认识论中先有主体再通达对象的图式，把理解放在实践生活世界之内。",
            "themeIds": [
              "metaphysics",
              "knowledge"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "heidegger:evidence:003",
                "titleZh": "在世存在依据",
                "summaryZh": "《存在与时间》把世界性分析为此在的基本结构，而不是外部对象集合，说明此在总已处在意义网络中。",
                "source": {
                  "workId": "heidegger-primary-work",
                  "locator": "《存在与时间》第一篇第三章第12节“在世存在概述”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "heidegger:evidence:009",
                "titleZh": "世界性结构依据",
                "summaryZh": "《存在与时间》对世界性的分析表明，世界首先以关涉、用途和意义整体出现，而非以孤立对象集合出现。",
                "source": {
                  "workId": "heidegger-primary-work",
                  "locator": "《存在与时间》第一篇第三章第14节“世界之为世界”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "heidegger:claim:004",
            "titleZh": "上手状态揭示实践世界",
            "claimZh": "海德格尔认为，器具首先在使用中以上手方式出现，只有故障或抽离时才成为对象。",
            "explanationZh": "该命题说明理论观察不是最原初的世界关系，日常实践中的使用和关涉更基础。",
            "themeIds": [
              "knowledge"
            ],
            "weight": 2,
            "evidence": [
              {
                "id": "heidegger:evidence:004",
                "titleZh": "上手分析依据",
                "summaryZh": "《存在与时间》通过器具分析展示实践关联如何先于理论凝视而显现世界，器具首先在使用中被理解。",
                "source": {
                  "workId": "heidegger-primary-work",
                  "locator": "《存在与时间》第15节“器具和上手状态”段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "heidegger:evidence:010",
                "titleZh": "故障显现对象依据",
                "summaryZh": "《存在与时间》说明器具在失灵、缺失或阻碍时才从顺手使用中凸显为现成对象，反证实践关联的优先性。",
                "source": {
                  "workId": "heidegger-primary-work",
                  "locator": "《存在与时间》第16节“上手者的故障和现成化”段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "heidegger:problem:003",
        "titleZh": "向死而在如何开启本真自由？",
        "questionZh": "海德格尔如何围绕“向死而在如何开启本真自由？”建立其思想问题？",
        "summaryZh": "海德格尔通过死亡、良知和决断分析此在如何从常人状态回到本己可能性。",
