                "source": {
                  "workId": "xunzi-primary-work",
                  "locator": "《荀子·性恶》“化性而起伪”段",
                  "publicDomainExcerptZh": "故圣人化性而起伪，伪起而生礼义，礼义生而制法度。",
                  "excerptStatus": "public_domain"
