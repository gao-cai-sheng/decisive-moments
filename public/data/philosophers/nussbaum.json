      {
        "id": "nussbaum:problem:001",
        "titleZh": "正义应衡量资源还是能力？",
        "questionZh": "努斯鲍姆如何围绕“正义应衡量资源还是能力？”建立其思想问题？",
        "summaryZh": "努斯鲍姆以能力进路强调人实际能够做什么和成为什么，而非只看资源或效用。",
        "themeIds": [
          "justice",
          "freedom"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "nussbaum:claim:001",
            "titleZh": "能力是尊严生活的实质机会",
            "claimZh": "努斯鲍姆主张，正义应保障每个人达到一组核心能力的门槛。",
            "explanationZh": "该命题把自由理解为实质可行能力，避免资源平等掩盖身体、社会和制度处境差异。",
            "themeIds": [
              "justice",
              "freedom"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "nussbaum:evidence:001",
                "titleZh": "核心能力依据",
                "summaryZh": "《女性与人的发展》提出核心人类能力清单，并把生命、身体完整、实践理性等能力作为正义门槛。",
                "source": {
                  "workId": "nussbaum-primary-work",
                  "locator": "《女性与人的发展》第一章第4节第6段",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "nussbaum:evidence:002",
                "titleZh": "门槛标准依据",
                "summaryZh": "同书强调每项核心能力都需达到足够门槛，不能用某一能力的高水平抵消另一能力缺失或被剥夺。",
                "source": {
                  "workId": "nussbaum-primary-work",
                  "locator": "《女性与人的发展》第一章第5节第3段",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "nussbaum:claim:002",
            "titleZh": "抽象平等需进入具体生活",
