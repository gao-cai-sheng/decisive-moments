                "source": {
                  "workId": "marcuse-eros-civilization",
                  "locator": "chapters on surplus repression and performance principle",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "marcuse:evidence:006",
                "titleZh": "《爱欲与文明》论绩效原则",
                "summaryZh": "绩效原则被解释为现代社会组织欲望和劳动的历史原则，它把生命能量导向生产纪律，并揭示现代主体如何被效率命令持续塑形。",
                "source": {
                  "workId": "marcuse-eros-civilization",
                  "locator": "chapter on performance principle",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "marcuse:claim:004",
            "titleZh": "新感性承载解放想象",
