  "thoughtSystem": {
    "problems": [
      {
        "id": "marcuse:problem:001",
        "titleZh": "技术理性与单向度社会",
        "questionZh": "马尔库塞如何解释发达工业社会通过技术理性和消费整合削弱批判能力？",
        "summaryZh": "马尔库塞认为发达工业社会以技术理性、消费需要和大众文化整合反抗，使个人难以想象制度外的生活可能。",
        "themeIds": [
          "politics",
          "knowledge"
        ],
        "weight": 3,
        "claims": [
          {
            "id": "marcuse:claim:001",
            "titleZh": "技术理性成为统治形式",
            "claimZh": "马尔库塞认为现代技术理性不只是中性工具，它会把社会目标重写为效率、控制和适应。",
            "explanationZh": "这种理性把政治冲突转化为管理问题，使现存制度显得唯一合理，从而压缩否定性和批判想象。",
            "themeIds": [
              "politics",
              "knowledge"
            ],
            "weight": 3,
            "evidence": [
              {
                "id": "marcuse:evidence:001",
                "titleZh": "《单向度的人》论技术理性",
                "summaryZh": "文本把技术理性描述为发达工业社会的统治逻辑，它通过效率和可操作性重塑需要、语言和判断。",
                "source": {
                  "workId": "marcuse-one-dimensional-man",
                  "locator": "chapters 1-2 on technological rationality",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "marcuse:evidence:002",
                "titleZh": "《理性与革命》追溯否定理性",
                "summaryZh": "文本通过黑格尔辩证法说明理性也可具有否定和批判功能，不应被化约为技术管理，从而保留社会理论反抗既成现实的尺度。",
                "source": {
                  "workId": "marcuse-reason-revolution",
                  "locator": "parts on Hegelian reason and social theory",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          },
          {
            "id": "marcuse:claim:002",
            "titleZh": "消费需要制造社会整合",
            "claimZh": "马尔库塞认为虚假需要和消费满足会把个人整合进制度，使支配以舒适和选择的形式出现。",
            "explanationZh": "统治不再只靠匮乏和暴力，也靠可购买的满足、媒体语言和生活方式，使反抗显得不必要。",
            "themeIds": [
              "freedom",
              "politics"
            ],
            "weight": 2,
            "evidence": [
              {
                "id": "marcuse:evidence:003",
                "titleZh": "《单向度的人》论虚假需要",
                "summaryZh": "马尔库塞把被广告、生产和社会竞争塑造的需要称为虚假需要，说明满足也可能服务服从。",
                "source": {
                  "workId": "marcuse-one-dimensional-man",
                  "locator": "chapter 1 on false needs",
                  "excerptStatus": "summary_only"
                }
              },
              {
                "id": "marcuse:evidence:004",
                "titleZh": "《压抑性宽容》论中立的统治效果",
                "summaryZh": "文章指出形式上平等的宽容在不平等传播结构中可能维护支配，使激进批判被同化或中和。",
                "source": {
                  "workId": "marcuse-repressive-tolerance",
                  "locator": "essay on tolerance and unequal society",
                  "excerptStatus": "summary_only"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "marcuse:problem:002",
        "titleZh": "爱欲、压抑与解放",
        "questionZh": "马尔库塞如何把精神分析中的欲望问题转化为文明批判和解放理论？",
        "summaryZh": "马尔库塞把弗洛伊德压抑理论改造为社会批判，主张文明组织欲望的方式并非不可改变。",
        "themeIds": [
